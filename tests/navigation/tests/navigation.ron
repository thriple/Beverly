// The navigation test level (stairs and a ramp up to a landing, a tower with no way up, a wall). Played: the walker
// walks up the stairs onto the landing. The paths: up the stairs, round the wall, and none onto the tower.
(
    steps: [
        (at: 0.4, shot: "start", expect: [
            Feet((0, 0, 8), 0.1),
            Path((0, 0, 8), (0, 2, -2), Some(10.2), 0.3),
            Path((5.5, 0, 7), (5.5, 0, 3), Some(8.3), 0.3),
            Path((0, 0, 8), (-7, 4, 2), None, 0),
        ]),
        (at: 0.5, press: ["W"]),
        (at: 3.1, release: ["W"]),
        (at: 3.6, shot: "landing", expect: [Feet((0, 1.95, -2.57), 0.3)]),
    ],
)
