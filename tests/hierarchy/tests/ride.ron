// A deck that rises and turns a quarter carries what is attached to it (a crate) and lifts what stands on it (the walker).
// The walker drifts a little sideways as the deck turns (about 0.2 m): riding the turn exactly is part 3 of the part hierarchy.
(
    steps: [
        (at: 0.4, shot: "start", expect: [Part("Crate", (1.5, 0.9, 0), 0.05), Feet((0, 0.7, 0), 0.1)]),
        (at: 0.5, press: ["E"]),
        (at: 0.6, release: ["E"]),
        (at: 4.0, shot: "up", expect: [Part("Deck", (0, 3.5, 0), 0.05), Part("Crate", (0, 3.9, -1.5), 0.05), Feet((0, 3.7, 0), 0.4)]),
    ],
)
