// Loose parts fall and tumble: two crates drop into a stack, a ball rolls down the still ramp (its low end toward +X)
// and on along the floor, and loose stairs (convex pieces) land flat. Physics runs on a fixed step, so the same run
// ends in the same places.
(
    steps: [
        (at: 0.2, shot: "start"),
        (at: 3.0, shot: "landed", expect: [
            Part("Crate 1", (-3, 0.5, 0), 0.1), Part("Crate 2", (-3.1, 1.5, 0), 0.15),
            Part("Loose stairs", (-6, 0.5, -3), 0.1), Part("Ball", (8.4, 0.4, 0.3), 0.5),
        ]),
    ],
)
